{
  "name": "cloudattend",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*", "infra"],
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "npm --workspace @cloudattend/web run dev",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm --workspace @cloudattend/api run test",
    "test:web": "npm --workspace @cloudattend/web run test",
    "cdk:synth": "npm --workspace @cloudattend/infra run synth",
    "check:secrets": "node scripts/check-secrets.mjs"
  }
}
